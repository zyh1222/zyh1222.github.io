---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.pages | where_exp: "page", "page.url != nil" %}
  {% for page in pages %}
    {% unless page.url contains "/404" or page.url contains "/feed.xml" or page.url contains "/sitemap.xml" or page.url contains ".css" or page.url contains ".txt" %}
  <url>
    <loc>{{ site.production_url }}{{ page.url | relative_url }}</loc>
    {% if page.path %}<lastmod>{{ site.time | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
    {% endunless %}
  {% endfor %}
</urlset>
